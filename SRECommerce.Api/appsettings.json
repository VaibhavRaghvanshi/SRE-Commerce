{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/srecommerce.db;Mode=ReadWrite"
  },
  "Jwt": {
    "Issuer": "SRECommerce",
    "Audience": "SRECommerceClient",
    "ExpiresMinutes": 360
  },
  "Database": {
    "Initialize": false
  },
  "DemoData": {
    "Enabled": false
  }
}
