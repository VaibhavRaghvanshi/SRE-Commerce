# Local infrastructure only. No credentials belong in this file.
MAILPIT_IMAGE=axllent/mailpit:v1.32.0
# Required for identity-api profile. Set the real value only in ignored .env.
# Use host.docker.internal,1433 and the restricted SRECommerce_IdentityDB runtime login.
# IDENTITY_SQL_CONNECTION=
# Required only when explicitly using compose.tenant.yaml / tenant-api profile:
# TENANT_SQL_CONNECTION=
# Optional commerce overlay uses the uppercase service name in these variable families.
# Supply values only for the services you intend to start, using the ignored local .env.
# THEME_SQL_CONNECTION=
# ORDER_SQL_CONNECTION=
# PAYMENT_SQL_CONNECTION=
# ORDER_SERVICE_CLIENT_SECRET=
# PAYMENT_SANDBOX_WEBHOOK_SIGNING_KEY=
# CATALOG_MEDIA_STORAGE=
# For an approved broker rollout, set each service's *_MESSAGING_ENABLED, *_BROKER_USERNAME
# and *_BROKER_PASSWORD alongside the matching broker and OAuth permissions.
# API production settings must be supplied separately through a secret provider:
# ConnectionStrings__Identity=
# Certificates__SigningPath=
# Certificates__SigningPassword=
# Certificates__EncryptionPath=
# Certificates__EncryptionPassword=
# Identity__DataProtectionPath=
